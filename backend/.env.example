# Calmspace Backend Environment Configuration (Placeholders Only)
# Copy to `backend/app/.env` (or inject via host secrets) for deployment. Never commit real secrets.

# Runtime Mode ('development' or 'production')
CALMSPACE_ENV=development
HOST=127.0.0.1
PORT=8000

# Allowed CORS Origins (comma-separated, no trailing slashes)
# In production (`CALMSPACE_ENV=production`), wildcard '*' is rejected; set your HTTPS frontend origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# SQLite Persistence (Issue #10)
# For container/hosted deployment with a persistent disk, point to e.g. sqlite:////data/calmspace.db
DATABASE_URL=sqlite:///./calmspace.db

# AI Guidance Service Configuration (Issue #5)
# Supported providers: 'mock' (offline safe default) or 'gemini'
CALMSPACE_AI_PROVIDER=mock
CALMSPACE_AI_MODEL=gemini-3.8-flash
CALMSPACE_AI_API_KEY=
CALMSPACE_AI_ENABLED=true
CALMSPACE_AI_TIMEOUT_SECONDS=5.0
CALMSPACE_AI_MAX_TOKENS=350
CALMSPACE_AI_RATE_LIMIT_PER_MINUTE=5
CALMSPACE_AI_DAILY_BUDGET_LIMIT=200
# Set to true only when running a single worker process in production without distributed rate limiting
CALMSPACE_AI_ALLOW_LOCAL_RATE_LIMITER=false

# Optional premium speech output. Browser speech is the default; keys stay backend-only.
CALMSPACE_VOICE_PROVIDER=browser
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_TIMEOUT_SECONDS=12.0
