# Calmspace Backend Environment Configuration
# Copy this file to `backend/.env` for local development.

# Application Environment
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# Allowed CORS Origins (comma-separated, no trailing slashes)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Database Persistence (Issue #10)
# Default is local SQLite. For hosted PostgreSQL/Supabase, provide postgresql://...
DATABASE_URL=sqlite:///./calmspace.db

# Optional AI Guidance Configuration (Issue #5)
# If empty or provider is 'none', backend gracefully uses deterministic empathetic fallback text.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
