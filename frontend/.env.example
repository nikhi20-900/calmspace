# Calmspace Frontend Environment Configuration
# Copy this file to `frontend/.env` or `frontend/.env.local` for custom development overrides.

# API Base URL. Default in Vite dev is '/api' (handled by Vite reverse proxy).
# In production, set to your deployed backend origin (e.g. https://api.calmspace.app/api).
VITE_API_BASE_URL=/api
